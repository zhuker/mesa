diff --git a/src/cudavk/cp_renderer.c b/src/cudavk/cp_renderer.c
index 369fd67a7d0..f41ab7b77cd 100644
--- a/src/cudavk/cp_renderer.c
+++ b/src/cudavk/cp_renderer.c
@@ -663,6 +663,392 @@ cp_scratch_destroy(struct cp_context *cp)
  * stopped firing is a slower sweep, which is indistinguishable from a dozen
  * other causes.
  */
+/*
+ * CUDAVK_DRAIN_PROBE. Instrumentation only, and off by default: nothing here
+ * changes what is issued, allocated or launched.
+ *
+ * P1 records the pair the tail drain already reads back -- the episode's
+ * fragment total and its quad count -- so the distribution of total/quads
+ * says whether sizing the shade arrays from the scan's exact fragment total
+ * is a small constant of over-allocation or four orders of magnitude.
+ *
+ * P2 records the host time between one drain returning and the next one
+ * starting: the inter-drain issue burst, which is the exact ceiling on any
+ * deferral mechanism, since it can recover at most min(burst, wait) per
+ * episode. `other` is how much of that gap the host spent blocked at the
+ * other synchronisation sites, so burst-minus-other is the part of it that
+ * is really issue.
+ *
+ * Samples are kept and printed once at teardown. An fprintf per episode
+ * would land inside the very burst P2 measures.
+ */
+#define CP_DRAIN_PROBE_MAX (1u << 20)
+
+static void
+cp_drain_probe_sample(struct cp_context *cp, uint32_t total, uint32_t quads,
+                      int64_t start_ns, int64_t wait_end_ns)
+{
+   if (!cp->plan.probe_total) {
+      cp->plan.probe_cap = CP_DRAIN_PROBE_MAX;
+      cp->plan.probe_total = calloc(cp->plan.probe_cap, 4);
+      cp->plan.probe_quads = calloc(cp->plan.probe_cap, 4);
+      cp->plan.probe_gap_ns = calloc(cp->plan.probe_cap, 4);
+      cp->plan.probe_other_ns = calloc(cp->plan.probe_cap, 4);
+      cp->plan.probe_wait_ns = calloc(cp->plan.probe_cap, 4);
+      if (!cp->plan.probe_total || !cp->plan.probe_quads ||
+          !cp->plan.probe_gap_ns || !cp->plan.probe_other_ns ||
+          !cp->plan.probe_wait_ns) {
+         cp->plan.probe_cap = 0;
+         return;
+      }
+   }
+
+   uint64_t other = cp->plan.wait_quads_ns + cp->plan.wait_peel_ns +
+                    cp->plan.wait_seg_ns + cp->plan.wait_upload_ns;
+   uint64_t i = cp->plan.probe_n++;
+   if (i < cp->plan.probe_cap) {
+      cp->plan.probe_total[i] = total;
+      cp->plan.probe_quads[i] = quads;
+      {
+         int64_t wait = wait_end_ns - start_ns;
+         cp->plan.probe_wait_ns[i] =
+            wait > 0 ? (uint32_t)MIN2(wait, (int64_t)UINT32_MAX) : 0;
+      }
+      if (cp->plan.probe_last_end_ns) {
+         int64_t gap = start_ns - cp->plan.probe_last_end_ns;
+         uint64_t oth = other - cp->plan.probe_last_other_ns;
+         cp->plan.probe_gap_ns[i] = gap > 0 ? (uint32_t)MIN2(gap, (int64_t)UINT32_MAX) : 0;
+         cp->plan.probe_other_ns[i] = (uint32_t)MIN2(oth, (uint64_t)UINT32_MAX);
+      } else {
+         cp->plan.probe_gap_ns[i] = UINT32_MAX;   /* no predecessor */
+         cp->plan.probe_other_ns[i] = 0;
+      }
+   }
+   cp->plan.probe_last_end_ns = os_time_get_nano();
+   cp->plan.probe_last_other_ns = other;
+}
+
+/*
+ * P3, the bound the clip-rectangle lead would use.
+ *
+ * Taken in the branch the driver reaches when the `bounded` predicate fails
+ * and it drains for the segment counters, because that is the only place both
+ * numbers exist: the host's product bound, and the device's actual quad count.
+ * fb_bound is what the predicate computes today (`ab->nblocks *
+ * rast_num_triangles`, whole framebuffer); clip_bound is the same product over
+ * the 2x2 blocks the batch's clip rectangle actually touches.
+ */
+enum {
+   CP_BP_KIND      = 1u << 0,   /* composite, not verify, not timing */
+   CP_BP_TRIS      = 1u << 1,   /* num_triangles <= 2 */
+   CP_BP_NDRAWS    = 1u << 2,   /* fs_batch.ndraws <= 1 */
+   CP_BP_FS        = 1u << 3,   /* fs present and writes no memory */
+   CP_BP_FB_SLOTS  = 1u << 4,   /* fb_bound * 4 <= 512 << 10 */
+   CP_BP_CLIP_SLOTS= 1u << 5,   /* clip_bound * 4 <= 512 << 10 */
+   CP_BP_CAP       = 1u << 6,   /* num_triangles * n <= capacity */
+   CP_BP_FB_QCAP   = 1u << 7,   /* fb_bound <= quad_capacity */
+   CP_BP_CLIP_QCAP = 1u << 8,   /* clip_bound <= quad_capacity */
+   CP_BP_SCISSOR   = 1u << 9,   /* the batch had a scissor at all */
+   CP_BP_PERDRAW   = 1u << 10,  /* ... one per draw, so the batch-wide
+                                 * rectangle carries none */
+};
+
+static void
+cp_bound_probe_sample(struct cp_context *cp, size_t fb_bound,
+                      size_t clip_bound, uint32_t quads, uint32_t flags,
+                      uint32_t nblocks, size_t clip_blocks, uint32_t tris)
+{
+   if (!cp->plan.probe_fb_bound) {
+      cp->plan.probe_fb_bound = calloc(CP_DRAIN_PROBE_MAX, 4);
+      cp->plan.probe_clip_bound = calloc(CP_DRAIN_PROBE_MAX, 4);
+      cp->plan.probe_bq = calloc(CP_DRAIN_PROBE_MAX, 4);
+      cp->plan.probe_bflags = calloc(CP_DRAIN_PROBE_MAX, 4);
+      cp->plan.probe_nblocks = calloc(CP_DRAIN_PROBE_MAX, 4);
+      cp->plan.probe_clipblocks = calloc(CP_DRAIN_PROBE_MAX, 4);
+      cp->plan.probe_btris = calloc(CP_DRAIN_PROBE_MAX, 4);
+      if (!cp->plan.probe_fb_bound || !cp->plan.probe_clip_bound ||
+          !cp->plan.probe_bq || !cp->plan.probe_bflags ||
+          !cp->plan.probe_nblocks || !cp->plan.probe_clipblocks ||
+          !cp->plan.probe_btris)
+         return;
+   }
+   uint64_t i = cp->plan.probe_bn++;
+   if (i >= CP_DRAIN_PROBE_MAX)
+      return;
+   /* In units of 1,024 quads: the framebuffer-wide product saturates a
+    * uint32 on this capture and a saturated sample is not a measurement. */
+   cp->plan.probe_fb_bound[i] =
+      (uint32_t)MIN2(fb_bound / 1024u, (size_t)UINT32_MAX);
+   cp->plan.probe_clip_bound[i] =
+      (uint32_t)MIN2(clip_bound / 1024u, (size_t)UINT32_MAX);
+   cp->plan.probe_bq[i] = quads;
+   cp->plan.probe_bflags[i] = flags;
+   cp->plan.probe_nblocks[i] = nblocks;
+   cp->plan.probe_clipblocks[i] =
+      (uint32_t)MIN2(clip_blocks, (size_t)UINT32_MAX);
+   cp->plan.probe_btris[i] = tris;
+}
+
+static int
+cp_probe_cmp_u32(const void *a, const void *b)
+{
+   uint32_t x = *(const uint32_t *)a, y = *(const uint32_t *)b;
+   return x < y ? -1 : x > y ? 1 : 0;
+}
+
+static void
+cp_probe_quantiles(const char *name, uint32_t *v, uint64_t n, double scale,
+                   const char *unit)
+{
+   if (!n) {
+      fprintf(stderr, "cudavk: drain probe: %s: no samples\n", name);
+      return;
+   }
+   qsort(v, n, 4, cp_probe_cmp_u32);
+   double sum = 0.0;
+   for (uint64_t i = 0; i < n; i++)
+      sum += (double)v[i];
+   fprintf(stderr,
+           "cudavk: drain probe: %s over %" PRIu64 " samples (%s): "
+           "min %.4f p10 %.4f p25 %.4f median %.4f p75 %.4f p90 %.4f "
+           "p99 %.4f max %.4f mean %.4f\n",
+           name, n, unit,
+           v[0] * scale,
+           v[(uint64_t)(0.10 * (n - 1))] * scale,
+           v[(uint64_t)(0.25 * (n - 1))] * scale,
+           v[(uint64_t)(0.50 * (n - 1))] * scale,
+           v[(uint64_t)(0.75 * (n - 1))] * scale,
+           v[(uint64_t)(0.90 * (n - 1))] * scale,
+           v[(uint64_t)(0.99 * (n - 1))] * scale,
+           v[n - 1] * scale, sum * scale / (double)n);
+}
+
+static void
+cp_drain_probe_report(struct cp_context *cp)
+{
+   if (!cp_debug->drain_probe || !cp->plan.probe_total)
+      return;
+
+   uint64_t n = MIN2(cp->plan.probe_n, cp->plan.probe_cap);
+   fprintf(stderr, "cudavk: drain probe: %" PRIu64 " episode drains recorded "
+           "of %" PRIu64 " seen\n", n, cp->plan.probe_n);
+
+   /* P1: the ratio, in thousandths so it can share the integer quantiler. */
+   uint32_t *ratio = calloc(n ? n : 1, 4);
+   uint64_t nr = 0, zero_quads = 0;
+   double rsum = 0.0;
+   uint64_t tsum = 0, qsum = 0;
+   for (uint64_t i = 0; i < n; i++) {
+      tsum += cp->plan.probe_total[i];
+      qsum += cp->plan.probe_quads[i];
+      if (!cp->plan.probe_quads[i]) {
+         zero_quads++;
+         continue;
+      }
+      double r = (double)cp->plan.probe_total[i] /
+                 (double)cp->plan.probe_quads[i];
+      rsum += r;
+      if (ratio)
+         ratio[nr] = (uint32_t)MIN2(r * 1000.0, (double)UINT32_MAX);
+      nr++;
+   }
+   fprintf(stderr, "cudavk: drain probe: P1 totals %" PRIu64 " quads %" PRIu64
+           " aggregate total/quads %.4f, %" PRIu64 " episodes had zero quads\n",
+           tsum, qsum, qsum ? (double)tsum / (double)qsum : 0.0, zero_quads);
+   if (ratio) {
+      cp_probe_quantiles("P1 total/quads", ratio, nr, 1e-3, "ratio");
+      free(ratio);
+   }
+   {
+      uint32_t *t = calloc(n ? n : 1, 4), *q = calloc(n ? n : 1, 4);
+      if (t && q) {
+         memcpy(t, cp->plan.probe_total, n * 4);
+         memcpy(q, cp->plan.probe_quads, n * 4);
+         cp_probe_quantiles("P1 fragment total", t, n, 1.0, "fragments");
+         cp_probe_quantiles("P1 quads", q, n, 1.0, "quads");
+      }
+      free(t);
+      free(q);
+   }
+
+   /* The empty drains: the host blocked to be told the episode covered
+    * nothing. Priced in the same units as the wait table. */
+   {
+      uint64_t empty_n = 0, empty_ns = 0, all_ns = 0;
+      for (uint64_t i = 0; i < n; i++) {
+         all_ns += cp->plan.probe_wait_ns[i];
+         if (!cp->plan.probe_quads[i]) {
+            empty_n++;
+            empty_ns += cp->plan.probe_wait_ns[i];
+         }
+      }
+      fprintf(stderr, "cudavk: drain probe: empty drains %" PRIu64 " of %"
+              PRIu64 " (%.1f%%), %.3f ms of %.3f ms blocked at this site "
+              "(%.1f%%), mean empty wait %.4f ms, mean nonempty %.4f ms\n",
+              empty_n, n, 100.0 * (double)empty_n / (double)MAX2(n, (uint64_t)1),
+              empty_ns / 1e6, all_ns / 1e6,
+              100.0 * (double)empty_ns / (double)MAX2(all_ns, (uint64_t)1),
+              empty_n ? empty_ns / 1e6 / (double)empty_n : 0.0,
+              (n - empty_n) ? (all_ns - empty_ns) / 1e6 / (double)(n - empty_n)
+                            : 0.0);
+   }
+
+   /* P3: what a host bound would have claimed at the `bounded` predicate. */
+   if (cp->plan.probe_fb_bound) {
+      uint64_t bn = MIN2(cp->plan.probe_bn, (uint64_t)CP_DRAIN_PROBE_MAX);
+      uint32_t *fbr = calloc(bn ? bn : 1, 4), *clr = calloc(bn ? bn : 1, 4);
+      uint32_t *clb = calloc(bn ? bn : 1, 4);
+      uint64_t nfb = 0, ncl = 0, zero_q = 0;
+      uint64_t adm_today = 0, adm_clip = 0, adm_clip_notris = 0,
+               adm_fb_notris = 0, tris_ok = 0, clip_slots_ok = 0;
+      for (uint64_t i = 0; i < bn; i++) {
+         uint32_t f = cp->plan.probe_bflags[i];
+         uint32_t qq = cp->plan.probe_bq[i];
+         uint32_t base = CP_BP_KIND | CP_BP_NDRAWS | CP_BP_FS | CP_BP_CAP;
+         if ((f & (base | CP_BP_TRIS | CP_BP_FB_SLOTS | CP_BP_FB_QCAP)) ==
+             (base | CP_BP_TRIS | CP_BP_FB_SLOTS | CP_BP_FB_QCAP))
+            adm_today++;
+         if ((f & (base | CP_BP_TRIS | CP_BP_CLIP_SLOTS | CP_BP_CLIP_QCAP)) ==
+             (base | CP_BP_TRIS | CP_BP_CLIP_SLOTS | CP_BP_CLIP_QCAP))
+            adm_clip++;
+         if ((f & (base | CP_BP_CLIP_SLOTS | CP_BP_CLIP_QCAP)) ==
+             (base | CP_BP_CLIP_SLOTS | CP_BP_CLIP_QCAP))
+            adm_clip_notris++;
+         if ((f & (base | CP_BP_FB_SLOTS | CP_BP_FB_QCAP)) ==
+             (base | CP_BP_FB_SLOTS | CP_BP_FB_QCAP))
+            adm_fb_notris++;
+         if (f & CP_BP_TRIS)
+            tris_ok++;
+         if (f & CP_BP_CLIP_SLOTS)
+            clip_slots_ok++;
+         if (!qq) {
+            zero_q++;
+            continue;
+         }
+         if (fbr)
+            fbr[nfb] = (uint32_t)MIN2((double)cp->plan.probe_fb_bound[i] *
+                                      1024.0 / (double)qq, (double)UINT32_MAX);
+         nfb++;
+         if (clr)
+            clr[ncl] = (uint32_t)MIN2((double)cp->plan.probe_clip_bound[i] *
+                                      1024.0 / (double)qq, (double)UINT32_MAX);
+         if (clb)
+            clb[ncl] = cp->plan.probe_clip_bound[i];
+         ncl++;
+      }
+      fprintf(stderr, "cudavk: drain probe: P3 %" PRIu64 " samples at the "
+              "bounded predicate, %" PRIu64 " with zero quads\n", bn, zero_q);
+      fprintf(stderr, "cudavk: drain probe: P3 admission: today %" PRIu64
+              " (%.2f%%), clip-rect bound %" PRIu64 " (%.2f%%), clip-rect and "
+              "no tris<=2 %" PRIu64 " (%.2f%%), fb bound and no tris<=2 %"
+              PRIu64 " (%.2f%%); tris<=2 alone %" PRIu64 " (%.2f%%), "
+              "clip slot test alone %" PRIu64 " (%.2f%%)\n",
+              adm_today, 100.0 * (double)adm_today / (double)MAX2(bn, (uint64_t)1),
+              adm_clip, 100.0 * (double)adm_clip / (double)MAX2(bn, (uint64_t)1),
+              adm_clip_notris,
+              100.0 * (double)adm_clip_notris / (double)MAX2(bn, (uint64_t)1),
+              adm_fb_notris,
+              100.0 * (double)adm_fb_notris / (double)MAX2(bn, (uint64_t)1),
+              tris_ok, 100.0 * (double)tris_ok / (double)MAX2(bn, (uint64_t)1),
+              clip_slots_ok,
+              100.0 * (double)clip_slots_ok / (double)MAX2(bn, (uint64_t)1));
+      if (fbr)
+         cp_probe_quantiles("P3 fb_bound/quads", fbr, nfb, 1.0, "ratio");
+      if (clr)
+         cp_probe_quantiles("P3 clip_bound/quads", clr, ncl, 1.0, "ratio");
+      if (clb)
+         cp_probe_quantiles("P3 clip_bound", clb, ncl, 1024.0, "quads");
+      {
+         uint32_t *nb = calloc(bn ? bn : 1, 4), *cb = calloc(bn ? bn : 1, 4);
+         uint32_t *tr = calloc(bn ? bn : 1, 4), *sh = calloc(bn ? bn : 1, 4);
+         uint64_t nsh = 0, tighter = 0;
+         for (uint64_t i = 0; i < bn; i++) {
+            if (nb) nb[i] = cp->plan.probe_nblocks[i];
+            if (cb) cb[i] = cp->plan.probe_clipblocks[i];
+            if (tr) tr[i] = cp->plan.probe_btris[i];
+            if (cp->plan.probe_clipblocks[i] < cp->plan.probe_nblocks[i])
+               tighter++;
+            if (sh && cp->plan.probe_nblocks[i]) {
+               /* clip blocks as a share of the framebuffer, in per mille */
+               sh[nsh++] = (uint32_t)((double)cp->plan.probe_clipblocks[i] *
+                                      1000.0 / (double)cp->plan.probe_nblocks[i]);
+            }
+         }
+         fprintf(stderr, "cudavk: drain probe: P3 clip rectangle tighter than "
+                 "the framebuffer in %" PRIu64 " of %" PRIu64 " samples "
+                 "(%.2f%%)\n", tighter, bn,
+                 100.0 * (double)tighter / (double)MAX2(bn, (uint64_t)1));
+         if (nb) cp_probe_quantiles("P3 framebuffer blocks", nb, bn, 1.0, "blocks");
+         if (cb) cp_probe_quantiles("P3 clip blocks", cb, bn, 1.0, "blocks");
+         if (sh) cp_probe_quantiles("P3 clip/framebuffer blocks", sh, nsh, 1e-3, "share");
+         if (tr) cp_probe_quantiles("P3 rast triangles", tr, bn, 1.0, "tris");
+         free(nb); free(cb); free(sh); free(tr);
+      }
+      {
+         uint32_t *qq = calloc(bn ? bn : 1, 4);
+         if (qq) {
+            memcpy(qq, cp->plan.probe_bq, bn * 4);
+            cp_probe_quantiles("P3 actual quads", qq, bn, 1.0, "quads");
+            free(qq);
+         }
+      }
+      free(fbr);
+      free(clr);
+      free(clb);
+      free(cp->plan.probe_fb_bound);
+      free(cp->plan.probe_clip_bound);
+      free(cp->plan.probe_bq);
+      free(cp->plan.probe_bflags);
+      free(cp->plan.probe_nblocks);
+      free(cp->plan.probe_clipblocks);
+      free(cp->plan.probe_btris);
+      cp->plan.probe_nblocks = NULL;
+      cp->plan.probe_clipblocks = NULL;
+      cp->plan.probe_btris = NULL;
+      cp->plan.probe_fb_bound = NULL;
+      cp->plan.probe_clip_bound = NULL;
+      cp->plan.probe_bq = NULL;
+      cp->plan.probe_bflags = NULL;
+   }
+
+   /* P2: the inter-drain gap, and the part of it that was not another wait. */
+   uint32_t *gap = calloc(n ? n : 1, 4), *iss = calloc(n ? n : 1, 4);
+   uint64_t ng = 0;
+   double gap_sum = 0.0, iss_sum = 0.0;
+   for (uint64_t i = 0; i < n; i++) {
+      if (cp->plan.probe_gap_ns[i] == UINT32_MAX)
+         continue;   /* first drain of the process, no predecessor */
+      uint32_t g = cp->plan.probe_gap_ns[i];
+      uint32_t o = MIN2(cp->plan.probe_other_ns[i], g);
+      if (gap)
+         gap[ng] = g;
+      if (iss)
+         iss[ng] = g - o;
+      gap_sum += g;
+      iss_sum += g - o;
+      ng++;
+   }
+   fprintf(stderr, "cudavk: drain probe: P2 gaps %" PRIu64 ", total gap %.3f "
+           "ms, of which issue %.3f ms\n", ng, gap_sum / 1e6, iss_sum / 1e6);
+   if (gap)
+      cp_probe_quantiles("P2 inter-drain gap", gap, ng, 1e-3, "us");
+   if (iss)
+      cp_probe_quantiles("P2 inter-drain issue", iss, ng, 1e-3, "us");
+   free(gap);
+   free(iss);
+
+   free(cp->plan.probe_total);
+   free(cp->plan.probe_quads);
+   free(cp->plan.probe_gap_ns);
+   free(cp->plan.probe_other_ns);
+   free(cp->plan.probe_wait_ns);
